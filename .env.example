# =============================================================================
# Arvin Dispensary OS — Local / Dev environment example
# =============================================================================
# Copy this file to `.env` for LOCAL DEVELOPMENT ONLY and fill in placeholder
# values. In production, credentials are pulled from AWS Secrets Manager at
# the secret path `prod/dispensary-os/dutchie` and these env vars are ignored
# unless AWS is unreachable.
#
# !!! NEVER commit a real `.env` file. NEVER put real credentials in this file.
#     Every value below is a PLACEHOLDER and must be replaced locally only.
# =============================================================================

# --- AWS configuration (used by the Secrets Manager loader) ------------------
# Standard AWS SDK env vars. If running on infra with an IAM role, you can omit
# the access keys and rely on the ambient credential chain.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=REPLACE_WITH_LOCAL_DEV_KEY
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_LOCAL_DEV_SECRET

# Override the secret path if needed (defaults to prod/dispensary-os/dutchie).
DUTCHIE_SECRET_PATH=prod/dispensary-os/dutchie

# --- Dutchie API fallback (LOCAL DEV ONLY) -----------------------------------
# These are only read when AWS Secrets Manager is unreachable / not configured.
# They must contain READ-ONLY Dutchie API keys. Placeholders only in this file.
DUTCHIE_API_BASE_URL=https://api.pos.dutchie.com
DUTCHIE_API_KEY_5TH_AVE=REPLACE_WITH_READONLY_KEY_FOR_5TH_AVE
DUTCHIE_API_KEY_9TH_AVE=REPLACE_WITH_READONLY_KEY_FOR_9TH_AVE

# --- Competitor radar --------------------------------------------------------
# Cron expression for the scheduled competitor sweep (default: every 6 hours).
COMPETITOR_SWEEP_CRON=0 */6 * * *
# Directory (relative to project root) where sweep JSON snapshots are written.
COMPETITOR_SWEEP_OUTPUT_DIR=data/competitor-sweeps


# --- Frontend (Next.js) console ----------------------------------------------
# The frontend deploys on Railway with build root = `frontend/` and CANNOT read
# repo-root modules/lib at runtime, so it uses its own env vars (see
# frontend/.env.example). Set these in the Railway frontend service:
#
#   CRON_SECRET           protects GET/POST /api/cron/dossier (fails closed if unset)
#   DUTCHIE_API_KEY_5TH_AVE / DUTCHIE_API_KEY_9TH_AVE / DUTCHIE_API_BASE_URL
#                         read-only Dutchie keys (no AWS Secrets Manager on frontend)
#   LLM_API_KEY           optional; falls back to ABACUS_API_KEY, else deterministic answer
#   LLM_API_BASE_URL      default https://routellm.abacus.ai/v1
#   LLM_MODEL             default gpt-4o-mini
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
# LLM_API_KEY=REPLACE_WITH_LLM_KEY
LLM_API_BASE_URL=https://routellm.abacus.ai/v1
LLM_MODEL=gpt-4o-mini
