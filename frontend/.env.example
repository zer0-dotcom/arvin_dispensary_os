# =============================================================================
# Arvin Dispensary OS — Frontend (Next.js) environment example
# =============================================================================
# Copy to `frontend/.env.local` for local dev, or set these in the Railway
# service whose build/deploy root is `frontend/`.
#
# The deployed frontend service's root is `frontend/` ONLY. It CANNOT reach the
# repo-root `modules/`/`lib/`/`scripts/` at runtime, so the dossier-refresh
# pipeline and the chat copilot are fully self-contained under `frontend/lib/`.
# That also means the AWS Secrets Manager loader is NOT available here — Dutchie
# credentials must be provided directly via the env vars below.
#
# !!! NEVER commit a real `.env*` file. Every value here is a PLACEHOLDER.
# =============================================================================

# --- Cron / dossier refresh route --------------------------------------------
# Protects GET/POST /api/cron/dossier. The route fails CLOSED (HTTP 500) if this
# is unset, and returns 401 on mismatch. Set a long random string in Railway.
# Trigger with either header:
#   Authorization: Bearer $CRON_SECRET
#   x-cron-secret: $CRON_SECRET
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# --- Dutchie API (READ-ONLY keys) --------------------------------------------
# Consumed by frontend/lib/pipeline/dutchie-client.ts. Must be READ-ONLY keys.
DUTCHIE_API_BASE_URL=https://api.pos.dutchie.com
DUTCHIE_API_KEY_5TH_AVE=REPLACE_WITH_READONLY_KEY_FOR_5TH_AVE
DUTCHIE_API_KEY_9TH_AVE=REPLACE_WITH_READONLY_KEY_FOR_9TH_AVE

# --- MiK conversational copilot (LLM) ----------------------------------------
# Backs POST /api/chat. Uses an OpenAI-compatible endpoint. If no key is present
# the copilot degrades gracefully to a deterministic, data-grounded fallback
# answer (no LLM call). ABACUS_API_KEY is used automatically if LLM_API_KEY is
# not set, so on Abacus infra no extra key is required.
# LLM_API_KEY=REPLACE_WITH_LLM_KEY
LLM_API_BASE_URL=https://routellm.abacus.ai/v1
LLM_MODEL=gpt-4o-mini

# --- Optional: data root override --------------------------------------------
# If set, the data-loader reads/writes dossier + scan JSON exclusively under
# this directory. Otherwise it uses `.` (cwd) then `..` as fallbacks.
# DATA_ROOT=/data
